+extern "C" {
+int gef_pco_indexed_compress_f64(const double*,std::size_t,std::size_t,std::size_t,void**);
+int gef_pco_indexed_compress_i64(const std::int64_t*,std::size_t,std::size_t,std::size_t,void**);
+int gef_pco_indexed_read_f64(const void*,std::size_t,std::size_t,double*);
+int gef_pco_indexed_read_i64(const void*,std::size_t,std::size_t,std::int64_t*);
+int gef_pco_indexed_open(const std::uint8_t*,std::size_t,std::size_t,void**);
+int gef_pco_indexed_info(const void*,std::size_t*,const std::uint8_t**,std::size_t*);
+void gef_pco_indexed_free(void*);
+}
+namespace gef_compressors { namespace pcodec {
+namespace detail {
+template<class T> struct IndexedAPI;
+template<> struct IndexedAPI<double> {
+    static constexpr std::size_t kind=1;
+    static constexpr auto encode=gef_pco_indexed_compress_f64;
+    static constexpr auto read=gef_pco_indexed_read_f64;
+};
+template<> struct IndexedAPI<std::int64_t> {
+    static constexpr std::size_t kind=2;
+    static constexpr auto encode=gef_pco_indexed_compress_i64;
+    static constexpr auto read=gef_pco_indexed_read_i64;
+};
+}
+template<class T> class Indexed {
+    void* handle_ = nullptr;
+    std::size_t n_=0, bytes_=0;
+    const std::uint8_t* data_=nullptr;
+    void info() { detail::check(gef_pco_indexed_info(handle_,&n_,&data_,&bytes_)); }
+public:
+    Indexed(const std::vector<T>& input,std::size_t chunk=262144,std::size_t page=262144) {
+        detail::check(detail::IndexedAPI<T>::encode(input.data(),input.size(),chunk,page,&handle_));
+        info();
+    }
+    explicit Indexed(const std::vector<std::uint8_t>& bytes) {
+        detail::check(gef_pco_indexed_open(bytes.data(),bytes.size(),detail::IndexedAPI<T>::kind,&handle_));
+        info();
+    }
+    ~Indexed(){gef_pco_indexed_free(handle_);}
+    Indexed(const Indexed&)=delete;
+    Indexed& operator=(const Indexed&)=delete;
+    Indexed(Indexed&& other) noexcept:handle_(std::exchange(other.handle_,nullptr)),n_(other.n_),bytes_(other.bytes_),data_(other.data_){}
+    std::size_t size() const {return n_;}
+    std::size_t size_in_bytes() const {return bytes_;}
+    std::size_t changed_values() const {return 0;}
+    std::vector<std::uint8_t> bytes() const {return {data_,data_+bytes_};}
+    void read(std::size_t start,std::size_t count,T* output) const {
+        detail::check(detail::IndexedAPI<T>::read(handle_,start,count,output));
+    }
+};
+}}
diff --git a/lib/fauna-ffi/src/indexed.rs b/lib/fauna-ffi/src/indexed.rs
new file mode 100644
index 00000000..9d7f4d14
--- /dev/null
+++ b/lib/fauna-ffi/src/indexed.rs
@@ -0,0 +1,390 @@
+//! Native Fauna model/residual segments with a counted positional directory.
+//! Model and residual decoding calls the authors' original routines.
+use super::*;
+use crate::types::CompressedSegmentBuilder;
+use std::ffi::c_void;
+
+const MAGIC: &[u8; 8] = b"GFFIDX01";
+const HEADER: usize = 32;
+const ENTRY: usize = 32;
+type Result<T> = std::result::Result<T, String>;
+fn put(bytes: &mut [u8], at: usize, value: usize) {
+    bytes[at..at + 8].copy_from_slice(&(value as u64).to_le_bytes());
+}
+fn word(bytes: &[u8], at: usize) -> Result<usize> {
+    let b = bytes
+        .get(at..at.checked_add(8).ok_or("index overflow")?)
+        .ok_or("truncated index")?;
+    usize::try_from(u64::from_le_bytes(b.try_into().unwrap())).map_err(|_| "index overflow".into())
+}
+struct Segment<'a> {
+    model: u8,
+    first: usize,
+    last: usize,
+    min: f32,
+    max: f32,
+    times: &'a [u8],
+    values: &'a [u8],
+    residuals: &'a [u8],
+}
+fn segment(bytes: &[u8]) -> Result<Segment<'_>> {
+    let mut r = Reader { bytes, pos: 0 };
+    let model = r.take(1)?[0];
+    let first = r.u64()? as usize;
+    let last = r.u64()? as usize;
+    let min = r.f32()?;
+    let max = r.f32()?;
+    let times = r.bytes()?;
+    let values = r.bytes()?;
+    let residuals = r.bytes()?;
+    if r.pos != bytes.len() || model > 2 || last < first || last > i64::MAX as usize {
+        return Err("invalid native segment".into());
+    }
+    let residual_n = residuals.last().copied().unwrap_or(0) as usize;
+    if residual_n >= last - first + 1 {
+        return Err("segment without model values".into());
+    }
+    Ok(Segment {
+        model,
+        first,
+        last,
+        min,
+        max,
+        times,
+        values,
+        residuals,
+    })
+}
+pub struct Indexed {
+    bytes: Vec<u8>,
+    n: usize,
+    segments: usize,
+}
+impl Indexed {
+    fn at(&self, i: usize) -> usize {
+        HEADER + ENTRY * i
+    }
+    fn get(&self, i: usize) -> Result<Segment<'_>> {
+        let at = self.at(i);
+        let off = word(&self.bytes, at + 16)?;
+        let len = word(&self.bytes, at + 24)?;
+        segment(
+            self.bytes
+                .get(off..off.checked_add(len).ok_or("offset overflow")?)
+                .ok_or("invalid segment bounds")?,
+        )
+    }
+    fn new(bytes: Vec<u8>) -> Result<Self> {
+        if bytes.len() < HEADER || &bytes[..8] != MAGIC {
+            return Err("wrong indexed Fauna format".into());
+        }
+        let n = word(&bytes, 8)?;
+        let segments = word(&bytes, 16)?;
+        let batch = word(&bytes, 24)?;
+        if batch == 0 || batch > i64::MAX as usize || segments > (bytes.len() - HEADER) / ENTRY {
+            return Err("invalid index sizes".into());
+        }
+        let obj = Self { bytes, n, segments };
+        let mut first = 0;
+        let mut payload = HEADER + ENTRY * segments;
+        for i in 0..segments {
+            let at = obj.at(i);
+            let base = word(&obj.bytes, at + 8)?;
+            let off = word(&obj.bytes, at + 16)?;
+            let len = word(&obj.bytes, at + 24)?;
+            if word(&obj.bytes, at)? != first || off != payload {
+                return Err("non-contiguous segment directory".into());
+            }
+            let s = obj.get(i)?;
+            if base.checked_add(s.first) != Some(first)
+                || s.last >= batch
+                || base.checked_add(s.last).filter(|&x| x < n).is_none()
+            {
+                return Err("invalid segment positions".into());
+            }
+            first = base + s.last + 1;
+            payload += len;
+        }
+        if first != n || payload != obj.bytes.len() {
+            return Err("incomplete indexed frame".into());
+        }
+        Ok(obj)
+    }
+    fn compress(values: &[f64], batch_size: usize) -> Result<(Self, usize)> {
+        if batch_size == 0 || batch_size > i64::MAX as usize {
+            return Err("batch size must be positive and bounded".into());
+        }
+        let mut payload = Vec::new();
+        let mut entries = Vec::<[usize; 4]>::new();
+        let mut changed = 0;
+        for (batch, src) in values.chunks(batch_size).enumerate() {
+            let floats: Vec<f32> = src
+                .iter()
+                .map(|&x| {
+                    let v = x as f32;
+                    changed += ((v as f64).to_bits() != x.to_bits()) as usize;
+                    v
+                })
+                .collect();
+            let frame = encode(&floats, false)?;
+            let mut r = Reader {
+                bytes: &frame,
+                pos: 16,
+            };
+            let segments = r.u64()? as usize;
+            for _ in 0..segments {
+                let begin = r.pos;
+                r.take(1)?;
+                let first = r.u64()? as usize;
+                r.u64()?;
+                r.take(8)?;
+                for _ in 0..3 {
+                    r.bytes()?;
+                }
+                let length = r.pos - begin;
+                entries.push([
+                    batch * batch_size + first,
+                    batch * batch_size,
+                    payload.len(),
+                    length,
+                ]);
+                payload.extend_from_slice(&frame[begin..r.pos]);
+            }
+            if r.pos != frame.len() {
+                return Err("unexpected native frame suffix".into());
+            }
+        }
+        let base = HEADER + ENTRY * entries.len();
+        let mut bytes = vec![0u8; base];
+        bytes[..8].copy_from_slice(MAGIC);
+        put(&mut bytes, 8, values.len());
+        put(&mut bytes, 16, entries.len());
+        put(&mut bytes, 24, batch_size);
+        for (i, entry) in entries.iter().enumerate() {
+            for (j, &value) in entry.iter().enumerate() {
+                put(
+                    &mut bytes,
+                    HEADER + ENTRY * i + 8 * j,
+                    if j == 2 { base + value } else { value },
+                );
+            }
+        }
+        bytes.extend_from_slice(&payload);
+        Ok((Self::new(bytes)?, changed))
+    }
+    fn read(&self, start: usize, dst: &mut [f64]) -> Result<()> {
+        if start
+            .checked_add(dst.len())
+            .filter(|&end| end <= self.n)
+            .is_none()
+        {
+            return Err("invalid query range".into());
+        }
+        if dst.is_empty() {
+            return Ok(());
+        }
+        let mut lo = 0;
+        let mut hi = self.segments;
+        while lo < hi {
+            let mid = lo + (hi - lo) / 2;
+            if word(&self.bytes, self.at(mid))? <= start {
+                lo = mid + 1;
+            } else {
+                hi = mid;
+            }
+        }
+        let mut id = lo.checked_sub(1).ok_or("missing segment")?;
+        let mut cursor = start;
+        let end = start + dst.len();
+        while cursor < end {
+            let at = self.at(id);
+            let base = word(&self.bytes, at + 8)?;
+            let s = self.get(id)?;
+            let last = (base + s.last + 1).min(end);
+            read_segment(
+                &s,
+                cursor - base - s.first,
+                last - cursor,
+                &mut dst[cursor - start..last - start],
+            )?;
+            cursor = last;
+            id += 1;
+        }
+        Ok(())
+    }
+}
+
+fn model_grid(s: &Segment<'_>, model_n: usize, lo: usize, hi: usize) -> Result<Vec<f32>> {
+    if lo >= hi {
+        return Ok(Vec::new());
+    }
+    let decoded_n = if s.model == models::GORILLA_ID {
+        hi
+    } else {
+        hi - lo
+    };
+    let mut ids = UnivariateIdBuilder::with_capacity(decoded_n);
+    let mut values = ValueBuilder::with_capacity(decoded_n);
+    if s.model == models::GORILLA_ID {
+        // Original Gorilla/Macaque decoder consumes preceding values. Bound it
+        // to the requested prefix, never a preceding unrelated segment.
+        let times: Vec<i64> = (s.first as i64..(s.first + hi) as i64).collect();
+        models::gorilla::grid(0, s.values, &mut ids, &times, &mut values, None);
+        return Ok(values.values_slice()[lo..hi].to_vec());
+    }
+    let times: Vec<i64> = ((s.first + lo) as i64..(s.first + hi) as i64).collect();
+    match s.model {
+        models::PMC_MEAN_ID => models::pmc_mean::grid(
+            0,
+            CompressedSegmentBuilder::decode_values_for_pmc_mean(s.min, s.max, s.values),
+            &mut ids,
+            &times,
+            &mut values,
+        ),
+        models::SWING_ID => {
+            let (first, last) =
+                CompressedSegmentBuilder::decode_values_for_swing(s.min, s.max, s.values);
+            models::swing::grid(
+                0,
+                s.first as i64,
+                (s.first + model_n - 1) as i64,
+                first,
+                last,
+                &mut ids,
+                &times,
+                &mut values,
+            );
+        }
+        _ => return Err("unknown model".into()),
+    }
+    Ok(values.values_slice().to_vec())
+}
+fn read_segment(s: &Segment<'_>, lo: usize, count: usize, dst: &mut [f64]) -> Result<()> {
+    let n = s.last - s.first + 1;
+    let residual_n = s.residuals.last().copied().unwrap_or(0) as usize;
+    let model_n = n - residual_n;
+    let hi = lo + count;
+    if hi > n || dst.len() != count {
+        return Err("invalid segment query".into());
+    }
+    if lo < model_n {
+        let values = model_grid(s, model_n, lo, hi.min(model_n))?;
+        for (out, &value) in dst.iter_mut().zip(&values) {
+            *out = value as f64;
+        }
+    }
+    if hi > model_n {
+        let last = model_grid(s, model_n, model_n - 1, model_n)?[0];
+        let needed = hi - model_n;
+        let times: Vec<i64> = ((s.first + model_n) as i64..(s.first + hi) as i64).collect();
+        let mut ids = UnivariateIdBuilder::with_capacity(needed);
+        let mut values = ValueBuilder::with_capacity(needed);
+        models::gorilla::grid(
+            0,
+            &s.residuals[..s.residuals.len() - 1],
+            &mut ids,
+            &times,
+            &mut values,
+            Some(last),
+        );
+        let offset = lo.saturating_sub(model_n);
+        let out_start = model_n.saturating_sub(lo);
+        for (out, &value) in dst[out_start..]
+            .iter_mut()
+            .zip(&values.values_slice()[offset..needed])
+        {
+            *out = value as f64;
+        }
+    }
+    Ok(())
+}
+
+fn slice_ok<T>(ptr: *const T, len: usize) -> bool {
+    len <= isize::MAX as usize / std::mem::size_of::<T>()
+        && (len == 0 || (!ptr.is_null() && (ptr as usize) % std::mem::align_of::<T>() == 0))
+}
+#[no_mangle]
+pub unsafe extern "C" fn gef_fauna_indexed_compress(
+    src: *const f64,
+    n: usize,
+    batch: usize,
+    out: *mut *mut c_void,
+    changed: *mut usize,
+) -> i32 {
+    ffi_call(|| {
+        if !slice_ok(src, n) || out.is_null() || changed.is_null() {
+            return Err("invalid indexed compression arguments".into());
+        }
+        let values = if n == 0 {
+            &[]
+        } else {
+            std::slice::from_raw_parts(src, n)
+        };
+        let (object, count) = Indexed::compress(values, batch)?;
+        *out = Box::into_raw(Box::new(object)).cast();
+        *changed = count;
+        Ok(())
+    })
+}
+#[no_mangle]
+pub unsafe extern "C" fn gef_fauna_indexed_open(
+    src: *const u8,
+    len: usize,
+    out: *mut *mut c_void,
+) -> i32 {
+    ffi_call(|| {
+        if !slice_ok(src, len) || out.is_null() {
+            return Err("invalid indexed open arguments".into());
+        }
+        let bytes = if len == 0 {
+            &[]
+        } else {
+            std::slice::from_raw_parts(src, len)
+        };
+        *out = Box::into_raw(Box::new(Indexed::new(bytes.to_vec())?)).cast();
+        Ok(())
+    })
+}
+#[no_mangle]
+pub unsafe extern "C" fn gef_fauna_indexed_info(
+    handle: *const c_void,
+    n: *mut usize,
+    bytes: *mut *const u8,
+    len: *mut usize,
+) -> i32 {
+    ffi_call(|| {
+        if handle.is_null() || n.is_null() || bytes.is_null() || len.is_null() {
+            return Err("invalid indexed info arguments".into());
+        }
+        let x = &*handle.cast::<Indexed>();
+        *n = x.n;
+        *bytes = x.bytes.as_ptr();
+        *len = x.bytes.len();
+        Ok(())
+    })
+}
+#[no_mangle]
+pub unsafe extern "C" fn gef_fauna_indexed_read(
+    handle: *const c_void,
+    start: usize,
+    n: usize,
+    dst: *mut f64,
+) -> i32 {
+    ffi_call(|| {
+        if handle.is_null() || !slice_ok(dst, n) {
+            return Err("invalid indexed read arguments".into());
+        }
+        let dst = if n == 0 {
+            &mut []
+        } else {
+            std::slice::from_raw_parts_mut(dst, n)
+        };
+        (&*handle.cast::<Indexed>()).read(start, dst)
+    })
+}
+#[no_mangle]
+pub unsafe extern "C" fn gef_fauna_indexed_free(handle: *mut c_void) {
+    if !handle.is_null() {
+        drop(Box::from_raw(handle.cast::<Indexed>()));
+    }
+}
diff --git a/lib/pcodec-ffi/src/indexed.rs b/lib/pcodec-ffi/src/indexed.rs
new file mode 100644
index 00000000..347b8895
--- /dev/null
+++ b/lib/pcodec-ffi/src/indexed.rs
@@ -0,0 +1,402 @@
+//! Indexed container over the ORIGINAL wrapped Pco chunk/page APIs.
+//! No decoded values or expanded decoder tables persist between queries.
+use super::{guard, input, output, valid_slice, CODEC_ERROR, INVALID, OK};
+use pco::data_types::Number;
+use pco::wrapped::{ChunkDecompressor, FileCompressor, FileDecompressor};
+use pco::{ChunkConfig, PagingSpec};
+use std::ffi::c_void;
+
+const HEADER: usize = 64;
+const CHUNK: usize = 48;
+const PAGE: usize = 40;
+const MAGIC: &[u8; 8] = b"GFPCPG01";
+type Result<T> = std::result::Result<T, String>;
+fn put(bytes: &mut [u8], at: usize, value: usize) {
+    bytes[at..at + 8].copy_from_slice(&(value as u64).to_le_bytes());
+}
+fn word(bytes: &[u8], at: usize) -> Result<usize> {
+    let b = bytes
+        .get(at..at.checked_add(8).ok_or("offset overflow")?)
+        .ok_or("truncated index")?;
+    usize::try_from(u64::from_le_bytes(b.try_into().unwrap())).map_err(|_| "index overflow".into())
+}
+fn part(bytes: &[u8], at: usize, len: usize) -> Result<&[u8]> {
+    bytes
+        .get(at..at.checked_add(len).ok_or("offset overflow")?)
+        .ok_or_else(|| "invalid payload bounds".into())
+}
+pub struct Indexed {
+    bytes: Vec<u8>,
+    n: usize,
+    chunks: usize,
+    pages: usize,
+    kind: usize,
+}
+impl Indexed {
+    fn page_at(&self, id: usize) -> usize {
+        HEADER + CHUNK * self.chunks + PAGE * id
+    }
+    fn chunk_at(&self, id: usize) -> usize {
+        HEADER + CHUNK * id
+    }
+    fn new(bytes: Vec<u8>, kind: usize) -> Result<Self> {
+        if bytes.len() < HEADER || &bytes[..8] != MAGIC {
+            return Err("wrong indexed Pco format".into());
+        }
+        let (n, chunks, pages) = (word(&bytes, 8)?, word(&bytes, 24)?, word(&bytes, 32)?);
+        if word(&bytes, 16)? != kind || word(&bytes, 56)? != bytes.len() || ![1, 2].contains(&kind)
+        {
+            return Err("wrong type or frame length".into());
+        }
+        if chunks > bytes.len() / CHUNK || pages > bytes.len() / PAGE {
+            return Err("invalid directory sizes".into());
+        }
+        let directory_end = HEADER
+            .checked_add(CHUNK * chunks)
+            .and_then(|x| x.checked_add(PAGE * pages))
+            .ok_or("index overflow")?;
+        if word(&bytes, 40)? != directory_end {
+            return Err("invalid header offset".into());
+        }
+        part(&bytes, directory_end, word(&bytes, 48)?)?;
+        let obj = Self {
+            bytes,
+            n,
+            chunks,
+            pages,
+            kind,
+        };
+        let mut expected_n = 0;
+        let mut expected_page = 0;
+        let mut payload = directory_end + word(&obj.bytes, 48)?;
+        for c in 0..chunks {
+            let at = obj.chunk_at(c);
+            let first = word(&obj.bytes, at)?;
+            let count = word(&obj.bytes, at + 8)?;
+            let offset = word(&obj.bytes, at + 16)?;
+            let length = word(&obj.bytes, at + 24)?;
+            let first_page = word(&obj.bytes, at + 32)?;
+            let n_pages = word(&obj.bytes, at + 40)?;
+            if first != expected_n
+                || count == 0
+                || offset != payload
+                || first_page != expected_page
+                || n_pages == 0
+                || n_pages > pages - expected_page
+            {
+                return Err("invalid chunk directory".into());
+            }
+            part(&obj.bytes, offset, length)?;
+            payload += length;
+            let mut chunk_n = 0usize;
+            for id in first_page..first_page + n_pages {
+                let p = obj.page_at(id);
+                let start = word(&obj.bytes, p)?;
+                let len = word(&obj.bytes, p + 8)?;
+                let owner = word(&obj.bytes, p + 16)?;
+                let off = word(&obj.bytes, p + 24)?;
+                let size = word(&obj.bytes, p + 32)?;
+                if start != expected_n
+                    || len == 0
+                    || len > n.saturating_sub(expected_n)
+                    || owner != c
+                    || off != payload
+                {
+                    return Err("invalid page directory".into());
+                }
+                part(&obj.bytes, off, size)?;
+                payload += size;
+                chunk_n += len;
+                expected_n += len;
+            }
+            if chunk_n != count {
+                return Err("chunk count mismatch".into());
+            }
+            expected_page += n_pages;
+        }
+        if expected_n != n || expected_page != pages || payload != obj.bytes.len() {
+            return Err("incomplete directory".into());
+        }
+        Ok(obj)
+    }
+    fn compress<T: Number>(
+        values: &[T],
+        chunk_size: usize,
+        page_size: usize,
+        kind: usize,
+    ) -> Result<Self> {
+        if chunk_size == 0 || page_size == 0 {
+            return Err("chunk/page size must be positive".into());
+        }
+        // Same balanced chunk/page partitioning as the authors' pcopage benchmark.
+        let chunks = PagingSpec::EqualPagesUpTo(chunk_size)
+            .n_per_page(values.len())
+            .map_err(|e| e.to_string())?;
+        let config = ChunkConfig::default().with_paging_spec(PagingSpec::EqualPagesUpTo(page_size));
+        let mut pages = 0usize;
+        for &n in &chunks {
+            pages += config
+                .paging_spec
+                .n_per_page(n)
+                .map_err(|e| e.to_string())?
+                .len();
+        }
+        let header_at = HEADER + CHUNK * chunks.len() + PAGE * pages;
+        let mut bytes = vec![0u8; header_at];
+        bytes[..8].copy_from_slice(MAGIC);
+        put(&mut bytes, 8, values.len());
+        put(&mut bytes, 16, kind);
+        put(&mut bytes, 24, chunks.len());
+        put(&mut bytes, 32, pages);
+        put(&mut bytes, 40, header_at);
+        let fc = FileCompressor::default();
+        fc.write_header(&mut bytes).map_err(|e| e.to_string())?;
+        let header_len = bytes.len() - header_at;
+        put(&mut bytes, 48, header_len);
+        let mut first = 0;
+        let mut page_id = 0;
+        for (c, &n) in chunks.iter().enumerate() {
+            let mut cc = fc
+                .chunk_compressor(&values[first..first + n], &config)
+                .map_err(|e| e.to_string())?;
+            let page_ns = cc.n_per_page();
+            let meta_at = bytes.len();
+            cc.write_meta(&mut bytes).map_err(|e| e.to_string())?;
+            let meta_len = bytes.len() - meta_at;
+            let at = HEADER + CHUNK * c;
+            for (field, value) in [first, n, meta_at, meta_len, page_id, page_ns.len()]
+                .into_iter()
+                .enumerate()
+            {
+                put(&mut bytes, at + 8 * field, value);
+            }
+            for (i, &page_n) in page_ns.iter().enumerate() {
+                let off = bytes.len();
+                cc.write_page(i, &mut bytes).map_err(|e| e.to_string())?;
+                let size = bytes.len() - off;
+                let p = HEADER + CHUNK * chunks.len() + PAGE * page_id;
+                for (field, value) in [first, page_n, c, off, size].into_iter().enumerate() {
+                    put(&mut bytes, p + 8 * field, value);
+                }
+                first += page_n;
+                page_id += 1;
+            }
+        }
+        let len = bytes.len();
+        put(&mut bytes, 56, len);
+        Self::new(bytes, kind)
+    }
+    fn read<T: Number + Default>(&self, start: usize, dst: &mut [T], kind: usize) -> Result<()> {
+        if kind != self.kind
+            || start
+                .checked_add(dst.len())
+                .filter(|&x| x <= self.n)
+                .is_none()
+        {
+            return Err("invalid query".into());
+        }
+        if dst.is_empty() {
+            return Ok(());
+        }
+        let (fd, rest) = FileDecompressor::new(part(
+            &self.bytes,
+            word(&self.bytes, 40)?,
+            word(&self.bytes, 48)?,
+        )?)
+        .map_err(|e| e.to_string())?;
+        if !rest.is_empty() {
+            return Err("invalid Pco header".into());
+        }
+        let mut lo = 0;
+        let mut hi = self.pages;
+        while lo < hi {
+            let mid = lo + (hi - lo) / 2;
+            if word(&self.bytes, self.page_at(mid))? <= start {
+                lo = mid + 1;
+            } else {
+                hi = mid;
+            }
+        }
+        let mut page = lo.checked_sub(1).ok_or("missing page")?;
+        let end = start + dst.len();
+        let mut cursor = start;
+        // Reuse native chunk metadata across pages WITHIN this range query.
+        // No uncharged persistent expanded tables or decoded-value cache.
+        let mut current: Option<(usize, ChunkDecompressor<T>)> = None;
+        let mut scratch = vec![T::default(); 256];
+        while cursor < end {
+            let p = self.page_at(page);
+            let first = word(&self.bytes, p)?;
+            let n = word(&self.bytes, p + 8)?;
+            let c = word(&self.bytes, p + 16)?;
+            if current.as_ref().map(|x| x.0) != Some(c) {
+                let at = self.chunk_at(c);
+                let meta = part(
+                    &self.bytes,
+                    word(&self.bytes, at + 16)?,
+                    word(&self.bytes, at + 24)?,
+                )?;
+                let (cd, rest) = fd
+                    .chunk_decompressor::<T, _>(meta)
+                    .map_err(|e| e.to_string())?;
+                if !rest.is_empty() {
+                    return Err("trailing chunk metadata".into());
+                }
+                current = Some((c, cd));
+            }
+            let bytes = part(
+                &self.bytes,
+                word(&self.bytes, p + 24)?,
+                word(&self.bytes, p + 32)?,
+            )?;
+            let mut pd = current
+                .as_mut()
+                .unwrap()
+                .1
+                .page_decompressor(bytes, n)
+                .map_err(|e| e.to_string())?;
+            let wanted_end = end.min(first + n);
+            let mut decoded = 0;
+            while first + decoded < wanted_end {
+                // Feed a contiguous requested span directly to the original
+                // decoder, as upstream's full-page benchmark does. Scratch is
+                // only needed for skipped prefixes and partial end batches.
+                let pos = first + decoded;
+                if pos >= cursor {
+                    let available = wanted_end - pos;
+                    let direct = if wanted_end == first + n {
+                        available
+                    } else {
+                        available / 256 * 256
+                    };
+                    if direct > 0 {
+                        let progress = pd
+                            .read(&mut dst[pos - start..pos - start + direct])
+                            .map_err(|e| e.to_string())?;
+                        if progress.n_processed != direct {
+                            return Err("incomplete native span".into());
+                        }
+                        decoded += direct;
+                        continue;
+                    }
+                }
+                // Upstream requires full 256-value batches, except at page end.
+                let take = (n - decoded).min(256);
+                let progress = pd.read(&mut scratch[..take]).map_err(|e| e.to_string())?;
+                if progress.n_processed != take {
+                    return Err("incomplete native batch".into());
+                }
+                let a = cursor.max(first + decoded);
+                let b = wanted_end.min(first + decoded + take);
+                if b > a {
+                    dst[a - start..b - start]
+                        .copy_from_slice(&scratch[a - first - decoded..b - first - decoded]);
+                }
+                decoded += take;
+            }
+            if decoded == n && !pd.into_src().is_empty() {
+                return Err("trailing page data".into());
+            }
+            cursor = wanted_end;
+            page += 1;
+        }
+        Ok(())
+    }
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn gef_pco_indexed_open(
+    src: *const u8,
+    len: usize,
+    kind: usize,
+    out: *mut *mut c_void,
+) -> i32 {
+    guard(|| {
+        if !valid_slice(src, len) || out.is_null() {
+            return INVALID;
+        }
+        match Indexed::new(input(src, len).to_vec(), kind) {
+            Ok(x) => {
+                *out = Box::into_raw(Box::new(x)).cast();
+                OK
+            }
+            Err(_) => CODEC_ERROR,
+        }
+    })
+}
+#[no_mangle]
+pub unsafe extern "C" fn gef_pco_indexed_info(
+    handle: *const c_void,
+    n: *mut usize,
+    bytes: *mut *const u8,
+    len: *mut usize,
+) -> i32 {
+    if handle.is_null() || n.is_null() || bytes.is_null() || len.is_null() {
+        return INVALID;
+    }
+    let x = &*handle.cast::<Indexed>();
+    *n = x.n;
+    *bytes = x.bytes.as_ptr();
+    *len = x.bytes.len();
+    OK
+}
+#[no_mangle]
+pub unsafe extern "C" fn gef_pco_indexed_free(handle: *mut c_void) {
+    if !handle.is_null() {
+        drop(Box::from_raw(handle.cast::<Indexed>()));
+    }
+}
+macro_rules! export_indexed {
+    ($ty:ty,$kind:expr,$encode:ident,$read:ident) => {
+        #[no_mangle]
+        pub unsafe extern "C" fn $encode(
+            src: *const $ty,
+            n: usize,
+            chunk: usize,
+            page: usize,
+            out: *mut *mut c_void,
+        ) -> i32 {
+            guard(|| {
+                if !valid_slice(src, n) || out.is_null() {
+                    return INVALID;
+                }
+                match Indexed::compress(input(src, n), chunk, page, $kind) {
+                    Ok(x) => {
+                        *out = Box::into_raw(Box::new(x)).cast();
+                        OK
+                    }
+                    Err(_) => CODEC_ERROR,
+                }
+            })
+        }
+        #[no_mangle]
+        pub unsafe extern "C" fn $read(
+            handle: *const c_void,
+            start: usize,
+            n: usize,
+            dst: *mut $ty,
+        ) -> i32 {
+            guard(|| {
+                if handle.is_null() || !valid_slice(dst, n) {
+                    return INVALID;
+                }
+                match (&*handle.cast::<Indexed>()).read(start, output(dst, n), $kind) {
+                    Ok(()) => OK,
+                    Err(_) => CODEC_ERROR,
+                }
+            })
+        }
+    };
+}
+export_indexed!(
+    f64,
+    1,
+    gef_pco_indexed_compress_f64,
+    gef_pco_indexed_read_f64
+);
+export_indexed!(
+    i64,
+    2,
+    gef_pco_indexed_compress_i64,
+    gef_pco_indexed_read_i64
+);
